---
import BaseLayout from './BaseLayout.astro';
import DocsSidebar from '../components/DocsSidebar.astro';

interface Props {
  title: string;
  description: string;
  headings?: { depth: number; slug: string; text: string }[];
}
const { title, description, headings = [] } = Astro.props;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<BaseLayout title={title} description={description}>
  <div class:list={['container', 'docs-shell', { 'has-toc': toc.length > 0 }]}>
    <aside class="docs-aside">
      <DocsSidebar />
    </aside>

    <article class="docs-content prose">
      <header class="docs-header">
        <p class="eyebrow"><a href="/docs/">Docs</a></p>
        <h1>{title}</h1>
        <p class="docs-lede">{description}</p>
      </header>
      <slot />
    </article>

    {
      toc.length > 0 && (
        <aside class="docs-toc" aria-label="On this page">
          <p class="docs-toc-heading eyebrow">On this page</p>
          <nav>
            <ul>
              {toc.map((h) => (
                <li class={h.depth === 3 ? 'toc-sub' : ''}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )
    }
  </div>
</BaseLayout>

<style>
  .docs-shell {
    display: grid;
    grid-template-columns: 14.5rem minmax(0, 1fr);
    gap: clamp(24px, 4vw, 56px);
    padding-block: 44px 80px;
    align-items: start;
  }
  .docs-shell.has-toc {
    grid-template-columns: 14.5rem minmax(0, 1fr) 13rem;
  }
  .docs-aside {
    position: sticky;
    top: calc(var(--up-header-h) + 24px);
  }
  .docs-content {
    max-width: var(--up-maxw-prose);
  }

  /* Right-hand "On this page" table of contents. */
  .docs-toc {
    position: sticky;
    top: calc(var(--up-header-h) + 24px);
    align-self: start;
    font-size: 0.88rem;
  }
  .docs-toc-heading {
    margin-bottom: 12px;
  }
  .docs-toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 3px;
    border-left: 1px solid var(--up-border);
  }
  .docs-toc a {
    display: block;
    padding: 5px 0 5px 14px;
    margin-left: -1px;
    border-left: 2px solid transparent;
    color: var(--up-text-muted);
    line-height: 1.4;
  }
  .docs-toc a:hover {
    color: var(--up-text-bright);
  }
  .docs-toc .toc-sub a {
    padding-left: 26px;
    font-size: 0.84rem;
  }
  .docs-toc a.active {
    color: var(--up-accent-light);
    border-left-color: var(--up-accent);
  }
  .docs-header {
    margin-bottom: 36px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--up-border);
  }
  .docs-header h1 {
    margin: 10px 0 0;
    font-size: clamp(2rem, 4vw, 2.6rem);
  }
  .docs-lede {
    margin-top: 14px;
    color: var(--up-text-muted);
    font-size: 1.08rem;
  }

  /* Below this width the right TOC would crowd the reading column — drop it. */
  @media (max-width: 1100px) {
    .docs-shell.has-toc {
      grid-template-columns: 14.5rem minmax(0, 1fr);
    }
    .docs-toc {
      display: none;
    }
  }
  @media (max-width: 860px) {
    .docs-shell,
    .docs-shell.has-toc {
      grid-template-columns: minmax(0, 1fr);
    }
    .docs-aside {
      position: static;
      padding-bottom: 20px;
      margin-bottom: 12px;
      border-bottom: 1px solid var(--up-border);
    }
  }
</style>

<script>
  // Scroll-spy: highlight the current section in the right-hand TOC.
  // Re-runs after client-router navigations; the data-spy guard prevents
  // duplicate observers on the same document.
  function initScrollSpy() {
    const toc = document.querySelector<HTMLElement>('.docs-toc');
    if (!toc || toc.dataset.spy) return;
    toc.dataset.spy = '1';
    const links = Array.from(toc.querySelectorAll<HTMLAnchorElement>('a'));
    if (!links.length) return;
    const byId = new Map(links.map((a) => [decodeURIComponent(a.hash.slice(1)), a]));
    const targets = links
      .map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))))
      .filter((el): el is HTMLElement => el !== null);

    let current: HTMLAnchorElement | null = null;
    const setActive = (id: string | undefined) => {
      const next = id ? byId.get(id) ?? null : null;
      if (next === current) return;
      current?.classList.remove('active');
      next?.classList.add('active');
      current = next;
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]) setActive(visible[0].target.id);
      },
      { rootMargin: '-80px 0px -70% 0px', threshold: 0 },
    );
    targets.forEach((t) => observer.observe(t));
  }
  document.addEventListener('astro:page-load', initScrollSpy);
  initScrollSpy();
</script>

<script>
  // Progressive enhancement: turn `.doc-tabs` blocks (raw HTML authored in the
  // Markdown) into an accessible tablist. Without this, panels just stack.
  // Re-runs after client-router navigations; :not(.is-enhanced) skips blocks
  // already upgraded on this document.
  function initDocTabs() {
  document.querySelectorAll<HTMLElement>('.doc-tabs:not(.is-enhanced)').forEach((tabs) => {
    const panels = Array.from(tabs.querySelectorAll<HTMLElement>(':scope > .doc-tab'));
    if (panels.length < 2) return;

    const tablist = document.createElement('div');
    tablist.className = 'doc-tablist';
    tablist.setAttribute('role', 'tablist');

    const buttons = panels.map((panel, i) => {
      const label = panel.dataset.tab || `Option ${i + 1}`;
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'doc-tab-btn';
      btn.textContent = label;
      btn.setAttribute('role', 'tab');
      btn.setAttribute('aria-selected', i === 0 ? 'true' : 'false');
      btn.tabIndex = i === 0 ? 0 : -1;
      panel.setAttribute('role', 'tabpanel');
      panel.hidden = i !== 0;
      btn.addEventListener('click', () => select(i));
      btn.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        e.preventDefault();
        const dir = e.key === 'ArrowRight' ? 1 : -1;
        select((i + dir + panels.length) % panels.length, true);
      });
      tablist.appendChild(btn);
      return btn;
    });

    function select(idx: number, focus = false) {
      panels.forEach((p, i) => (p.hidden = i !== idx));
      buttons.forEach((b, i) => {
        const on = i === idx;
        b.setAttribute('aria-selected', on ? 'true' : 'false');
        b.tabIndex = on ? 0 : -1;
      });
      if (focus) buttons[idx].focus();
    }

    tabs.classList.add('is-enhanced');
    tabs.prepend(tablist);
  });
  }
  document.addEventListener('astro:page-load', initDocTabs);
  initDocTabs();
</script>

<!-- Prose styling for rendered Markdown. Global (not scoped) so it reaches the
     <slot> Markdown, but namespaced under .prose to avoid leaking elsewhere. -->
<style is:global>
  .prose {
    font-size: 1.02rem;
    line-height: 1.72;
    color: var(--up-text);
  }
  .prose h2 {
    margin-top: 2.2em;
    margin-bottom: 0.6em;
    font-size: 1.5rem;
    scroll-margin-top: calc(var(--up-header-h) + 20px);
  }
  .prose h3 {
    margin-top: 1.7em;
    margin-bottom: 0.5em;
    font-size: 1.2rem;
    scroll-margin-top: calc(var(--up-header-h) + 20px);
  }
  .prose h4 {
    margin-top: 1.6em;
    margin-bottom: 0.4em;
    font-family: var(--up-font-display);
    font-weight: 600;
    font-size: 1.06rem;
    color: var(--up-text-bright);
    scroll-margin-top: calc(var(--up-header-h) + 20px);
  }

  /* Tabbed sections (e.g. Lua vs native backend). Progressive: without JS the
     panels render stacked, each labelled from its data-tab; the enhancer in the
     script below turns them into a real tablist. */
  .prose .doc-tabs {
    margin: 1.9em 0;
  }
  .prose .doc-tablist {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-bottom: 22px;
    border-bottom: 1px solid var(--up-border);
  }
  .prose .doc-tab-btn {
    appearance: none;
    background: transparent;
    border: 0;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    padding: 10px 18px;
    font-family: var(--up-font-display);
    font-weight: 500;
    font-size: 1rem;
    color: var(--up-text-muted);
    cursor: pointer;
    transition:
      color 0.18s ease,
      border-color 0.18s ease,
      background 0.18s ease;
  }
  .prose .doc-tab-btn:hover {
    color: var(--up-text-bright);
  }
  .prose .doc-tab-btn[aria-selected='true'] {
    color: var(--up-accent-light);
    border-bottom-color: var(--up-accent);
  }
  .prose .doc-tab-btn:focus-visible {
    outline: 2px solid var(--up-accent);
    outline-offset: -2px;
    border-radius: var(--up-radius-sm) var(--up-radius-sm) 0 0;
  }
  .prose .doc-tab > :first-child {
    margin-top: 0;
  }
  .prose .doc-tab[hidden] {
    display: none;
  }
  /* No-JS fallback: label each stacked panel from its data-tab. */
  .prose .doc-tabs:not(.is-enhanced) .doc-tab {
    margin-top: 1.8em;
  }
  .prose .doc-tabs:not(.is-enhanced) .doc-tab::before {
    content: attr(data-tab);
    display: block;
    font-family: var(--up-font-display);
    font-weight: 600;
    font-size: 1.3rem;
    color: var(--up-text-bright);
    margin-bottom: 0.7em;
  }
  .prose p,
  .prose ul,
  .prose ol {
    margin-bottom: 1.1em;
  }
  .prose ul,
  .prose ol {
    padding-left: 1.4em;
  }
  .prose li {
    margin-bottom: 0.4em;
  }
  .prose li::marker {
    color: var(--up-accent-deep);
  }
  .prose a {
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-color: var(--up-border-strong);
  }
  .prose a:hover {
    text-decoration-color: var(--up-accent);
  }
  .prose strong {
    color: var(--up-text-bright);
    font-weight: 600;
  }
  .prose code:not(pre code) {
    padding: 0.15em 0.42em;
    border-radius: 5px;
    background: rgba(242, 181, 68, 0.1);
    border: 1px solid var(--up-border);
    color: var(--up-accent-pale);
    font-size: 0.86em;
  }
  .prose pre {
    margin-bottom: 1.4em;
    padding: 16px 18px;
    border-radius: var(--up-radius);
    border: 1px solid var(--up-border);
    background: #0d121d !important;
    overflow-x: auto;
    font-size: 0.86rem;
    line-height: 1.6;
  }
  .prose table {
    width: 100%;
    margin-bottom: 1.4em;
    border-collapse: collapse;
    font-size: 0.92rem;
  }
  .prose th,
  .prose td {
    padding: 9px 12px;
    text-align: left;
    border: 1px solid var(--up-border);
    vertical-align: top;
  }
  .prose th {
    background: rgba(242, 181, 68, 0.08);
    color: var(--up-text-bright);
    font-family: var(--up-font-display);
    font-weight: 600;
  }
  .prose td code {
    white-space: nowrap;
  }
  .prose .formula {
    margin: 1.2em 0 1.4em;
    padding: 12px 16px;
    border-radius: var(--up-radius-sm);
    border: 1px solid var(--up-border);
    background: rgba(242, 181, 68, 0.04);
    font-family: var(--up-font-mono);
    font-size: 0.92rem;
    color: var(--up-accent-pale);
    text-align: center;
    overflow-x: auto;
  }
  .prose blockquote {
    margin: 0 0 1.3em;
    padding: 4px 18px;
    border-left: 3px solid var(--up-accent-deep);
    background: rgba(242, 181, 68, 0.05);
    border-radius: 0 var(--up-radius-sm) var(--up-radius-sm) 0;
    color: var(--up-text-muted);
  }
  .prose blockquote p:last-child {
    margin-bottom: 0;
  }
  .prose hr {
    margin: 2.4em 0;
    border: none;
    border-top: 1px solid var(--up-border);
  }
  .prose img {
    display: block;
    margin: 1.8em auto;
    max-width: min(100%, 34rem);
  }
  /* On narrow viewports, let wide tables scroll instead of overflowing the
     reading column (display:block keeps rows intact and adds the scrollbar). */
  @media (max-width: 860px) {
    .prose table {
      display: block;
      overflow-x: auto;
    }
  }
</style>
