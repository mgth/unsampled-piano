---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FeatureCard from '../../../components/FeatureCard.astro';
import GlowBackground from '../../../components/GlowBackground.astro';
import { PARAMS, COUNTS, anchor, fmtValue } from '../../../lib/params';

const pages = (await getCollection('docs'))
  .filter((e) => e.data.section === 'Parameters')
  .sort((a, b) => a.data.order - b.data.order);
const slugOf = new Map(pages.map((e) => [e.data.page, e.id]));
const countOf = (page: string) => PARAMS.filter((p) => p.page === page).length;
const liveOf = (page: string) => PARAMS.filter((p) => p.page === page && p.live).length;
const rows = [...PARAMS].sort((a, b) => a.path.localeCompare(b.path));
---

<BaseLayout
  title="Parameter reference"
  description={`All ${COUNTS.total} parameters of Unsampled Piano — what each one is on a real piano, how the model implements it, its default and range — with diagrams of the parts they act on.`}
>
  <section class="params-hero">
    <GlowBackground />
    <div class="container params-hero-inner">
      <p class="eyebrow">Parameter reference</p>
      <h1 class="glow-text">Every knob is a piece of the piano</h1>
      <p class="params-lede">
        No macro controls, no "brightness" slider: each parameter is a physical quantity of the
        instrument — a felt's stiffness, a string's tension, a board's mass, a wall's absorption.
        The interface groups them in the pages below; this reference follows the same pages, with
        the help text the application shows, generated from the code.
      </p>
      <div class="params-stats">
        <div><strong data-count={COUNTS.total}>{COUNTS.total}</strong><span>parameters</span></div>
        <div><strong class="live" data-count={COUNTS.live}>{COUNTS.live}</strong><span>live &amp; automatable</span></div>
        <div><strong data-count={COUNTS.total - COUNTS.live}>{COUNTS.total - COUNTS.live}</strong><span>rebuild in the background</span></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="kinds">
        <div class="card kind" data-reveal>
          <span class="badge badge-live">live</span>
          <p>
            Applied by the running engine at once, smoothed where it matters. In the plugin these are
            the host parameters you can automate: output gain, pedal and damper behaviour, the velocity
            curve, the soft pedals, repetition, mechanical noises.
          </p>
        </div>
        <div class="card kind" data-reveal style="--reveal-delay: 100ms">
          <span class="badge badge-rebuild">rebuild</span>
          <p>
            Shapes the precomputed instrument — string modes, soundboard modes, radiation weights. Change
            one and the instrument is rebuilt in the background (≈ 0.1 s) and swapped in without cutting
            the notes you are holding. In the plugin they are saved with the project.
          </p>
        </div>
      </div>

      <div class="grid-pages">
        {pages.map((e, i) => (
          <FeatureCard title={e.data.title} href={`/docs/${e.id}/`} cta={`${countOf(e.data.page!)} parameters${liveOf(e.data.page!) ? ` · ${liveOf(e.data.page!)} live` : ''}`} icon={e.data.icon} reveal={i * 50}>
            <p>{e.data.description}</p>
          </FeatureCard>
        ))}
      </div>

      <h2 class="index-title" id="all">All parameters</h2>
      <p class="index-sub">
        By path — the name used in preset files, MIDI learn and host automation.
        <label class="index-search">
          <span class="visually-hidden">Filter</span>
          <input type="search" placeholder="filter: damper, hz, lid…" data-filter />
        </label>
      </p>
      <div class="index-wrap">
        <table class="index-table">
          <thead>
            <tr><th>Path</th><th>Name</th><th>Default</th><th>Page</th><th></th></tr>
          </thead>
          <tbody>
            {rows.map((p) => (
              <tr data-text={`${p.path} ${p.label} ${p.page}`.toLowerCase()}>
                <td><a href={`/docs/${slugOf.get(p.page)}/#${anchor(p.path)}`}><code>{p.path}</code></a></td>
                <td>{p.label}</td>
                <td class="num">{fmtValue(p)}</td>
                <td>{p.page}</td>
                <td>{p.live && <span class="badge badge-live">live</span>}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="index-empty" hidden data-empty>No parameter matches.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  function initFilter() {
    const input = document.querySelector<HTMLInputElement>('[data-filter]');
    if (!input || input.dataset.bound) return;
    input.dataset.bound = '1';
    const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>('.index-table tbody tr'));
    const empty = document.querySelector<HTMLElement>('[data-empty]')!;
    input.addEventListener('input', () => {
      const words = input.value.toLowerCase().split(/\s+/).filter(Boolean);
      let shown = 0;
      for (const r of rows) {
        const ok = words.every((w) => r.dataset.text!.includes(w));
        r.hidden = !ok;
        shown += Number(ok);
      }
      empty.hidden = shown > 0;
    });
  }
  // Count-up of the hero numbers, once.
  function countUp() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    document.querySelectorAll<HTMLElement>('[data-count]:not([data-counted])').forEach((el) => {
      el.dataset.counted = '1';
      const end = Number(el.dataset.count);
      const t0 = performance.now();
      const step = (now: number) => {
        const u = Math.min(1, (now - t0) / 1100);
        el.textContent = String(Math.round(end * (1 - (1 - u) ** 3)));
        if (u < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    });
  }
  document.addEventListener('astro:page-load', () => {
    initFilter();
    countUp();
  });
  initFilter();
  countUp();
</script>

<style>
  .params-hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--up-border);
    background: radial-gradient(120% 100% at 30% 0%, var(--up-bg-radial-from), var(--up-bg-radial-to) 70%);
  }
  .params-hero-inner {
    position: relative;
    z-index: 1;
    padding-block: clamp(48px, 8vw, 88px);
  }
  .params-hero h1 {
    margin-top: 12px;
    max-width: 18ch;
    font-size: clamp(2.2rem, 6vw, 3.4rem);
  }
  .params-lede {
    margin-top: 18px;
    max-width: 62ch;
    font-size: 1.1rem;
  }
  .params-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 40px;
    margin-top: 30px;
  }
  .params-stats div {
    display: grid;
  }
  .params-stats strong {
    font-family: var(--up-font-display);
    font-size: 2.4rem;
    line-height: 1.1;
    color: var(--up-accent-light);
    font-variant-numeric: tabular-nums;
  }
  .params-stats strong.live {
    color: var(--up-positive);
  }
  .params-stats span {
    font-family: var(--up-font-mono);
    font-size: 0.78rem;
    color: var(--up-text-muted);
  }
  .kinds {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: 18px;
    margin-bottom: 36px;
  }
  .kind p {
    margin-top: 10px;
    color: var(--up-text-muted);
    font-size: 0.97rem;
  }
  .badge {
    display: inline-block;
    padding: 1px 9px;
    border-radius: 999px;
    font-family: var(--up-font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .badge-live {
    color: var(--up-positive);
    border: 1px solid color-mix(in srgb, var(--up-positive) 45%, transparent);
    background: color-mix(in srgb, var(--up-positive) 10%, transparent);
  }
  .badge-rebuild {
    color: var(--up-text-muted);
    border: 1px solid var(--up-border-strong);
  }
  .grid-pages {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 16px;
  }
  .index-title {
    margin-top: clamp(48px, 7vw, 80px);
    font-size: clamp(1.6rem, 3.6vw, 2.2rem);
    scroll-margin-top: calc(var(--up-header-h) + 16px);
  }
  .index-sub {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 10px;
    color: var(--up-text-muted);
  }
  .index-search input {
    width: min(22rem, 80vw);
    padding: 8px 12px;
    border-radius: var(--up-radius-sm);
    border: 1px solid var(--up-border-strong);
    background: var(--up-bg-elevated);
    color: var(--up-text-bright);
    font-family: var(--up-font-mono);
    font-size: 0.85rem;
  }
  .index-search input:focus {
    outline: none;
    border-color: var(--up-accent);
    box-shadow: 0 0 0 3px rgba(242, 181, 68, 0.2);
  }
  .index-wrap {
    margin-top: 18px;
    overflow-x: auto;
    border: 1px solid var(--up-border);
    border-radius: var(--up-radius);
  }
  .index-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
  }
  .index-table th,
  .index-table td {
    padding: 7px 12px;
    text-align: left;
    border-bottom: 1px solid var(--up-border);
    white-space: nowrap;
  }
  .index-table th {
    position: sticky;
    top: 0;
    background: var(--up-bg-elevated);
    font-family: var(--up-font-display);
    color: var(--up-text-bright);
  }
  .index-table tbody tr:hover {
    background: rgba(242, 181, 68, 0.05);
  }
  .index-table code {
    color: var(--up-accent);
    font-size: 0.85em;
  }
  .index-table .num {
    font-family: var(--up-font-mono);
    font-size: 0.82rem;
    color: var(--up-text-muted);
  }
  .index-empty {
    padding: 16px;
    color: var(--up-text-muted);
  }
</style>
