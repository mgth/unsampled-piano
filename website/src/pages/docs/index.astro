---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeatureCard from '../../components/FeatureCard.astro';

const docs = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);
const guides = docs.filter((d) => d.data.section === 'Guides');
const params = docs.filter((d) => d.data.section === 'Parameters');
---

<BaseLayout
  title="Documentation"
  description="How to install and play Unsampled Piano, drive it from MIDI and the command line, how its physics works — and every parameter, with diagrams."
>
  <section class="section">
    <div class="container">
      <header class="docs-index-head">
        <p class="eyebrow">Docs &amp; guides</p>
        <h1>Lift the lid</h1>
        <p class="docs-index-lede">
          How to get it playing, how to drive it, and what is going on inside. Something missing or
          wrong? The site lives in the repository — an issue or a pull request is the best way to say so.
        </p>
      </header>

      <div class="docs-index-grid">
        {guides.map((entry, i) => (
          <FeatureCard title={entry.data.title} href={`/docs/${entry.id}/`} cta="Read" icon={entry.data.icon} reveal={i * 60}>
            <p>{entry.data.description}</p>
          </FeatureCard>
        ))}
      </div>

      <header class="docs-index-head docs-index-params">
        <p class="eyebrow"><a href="/docs/parameters/">Parameter reference</a></p>
        <h2>Every page of the interface</h2>
      </header>
      <div class="docs-index-grid three">
        {params.map((entry, i) => (
          <FeatureCard title={entry.data.title} href={`/docs/${entry.id}/`} cta="Parameters" icon={entry.data.icon} reveal={i * 40}>
            <p>{entry.data.description}</p>
          </FeatureCard>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .docs-index-head {
    max-width: 60ch;
    margin-bottom: 40px;
  }
  .docs-index-head h1 {
    margin-top: 10px;
    font-size: clamp(2rem, 5vw, 2.8rem);
  }
  .docs-index-params {
    margin-top: clamp(48px, 7vw, 80px);
    margin-bottom: 28px;
  }
  .docs-index-params h2 {
    margin-top: 10px;
    font-size: clamp(1.5rem, 3.4vw, 2rem);
  }
  .docs-index-lede {
    margin-top: 16px;
    color: var(--up-text-muted);
    font-size: 1.1rem;
  }
  .docs-index-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }
  .docs-index-grid.three {
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
  }
  @media (max-width: 680px) {
    .docs-index-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
