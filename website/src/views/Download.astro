---
import BaseLayout from '../layouts/BaseLayout.astro';
import GlowBackground from '../components/GlowBackground.astro';
import { SITE } from '../site';
import { langOf, localePath } from '../i18n';

// The download page, English or French (src/pages/download.astro, src/pages/fr/download.astro).
const lang = langOf(Astro.url);
const L = (p: string) => localePath(lang, p);
const fr = lang === 'fr';
const T = {
  en: {
    title: 'Download',
    description:
      'Unsampled Piano for Windows, macOS and Linux — the standalone application and the CLAP/VST3 plugin, from the latest GitHub release, or built from source.',
    head: 'Get the piano',
    lede: (rel: string) =>
      `Builds for Windows, macOS and Linux come straight from the project’s GitHub Actions and the latest <a href="${rel}" rel="noopener">release</a> — <span data-detected-os>pick your platform below</span>. Free software, ${SITE.license}. No account, no activation, no samples to download: the whole instrument is a few megabytes of code.`,
    looking: 'Looking for the latest release…',
    linuxSource: (href: string) => `The standalone player builds from source in one command — <a href="${href}">see Linux</a>.`,
    buildTitle: 'Or build it',
    buildText: 'It is a Rust workspace; a stable toolchain is all it takes (plus the audio and window headers on Linux).',
    buildPlayer: '# the standalone player',
    buildPlugin: '# the CLAP and VST3 plugins',
    more: (href: string) => `Next: <a href="${href}">getting started</a> — where everything installs, the first sound, personal defaults.`,
  },
  fr: {
    title: 'Télécharger',
    description:
      'Unsampled Piano pour Windows, macOS et Linux — l’application autonome et le plugin CLAP/VST3, depuis la dernière version publiée sur GitHub, ou compilés depuis les sources.',
    head: 'Récupérer le piano',
    lede: (rel: string) =>
      `Les versions pour Windows, macOS et Linux sortent directement des GitHub Actions du projet et de la dernière <a href="${rel}" rel="noopener">version publiée</a> — <span data-detected-os>choisissez votre système ci-dessous</span>. Logiciel libre, ${SITE.license}. Pas de compte, pas d’activation, pas d’échantillons à télécharger : l’instrument entier tient en quelques mégaoctets de code.`,
    looking: 'Recherche de la dernière version…',
    linuxSource: (href: string) => `L’application autonome se compile depuis les sources en une commande — <a href="${href}">voir Linux</a>.`,
    buildTitle: 'Ou compilez-le',
    buildText: 'C’est un espace de travail Rust ; une chaîne d’outils stable suffit (plus les en-têtes audio et fenêtrage sous Linux).',
    buildPlayer: '# l’application autonome',
    buildPlugin: '# les plugins CLAP et VST3',
    more: (href: string) => `Ensuite : <a href="${href}">premiers pas</a> — où tout s’installe, le premier son, vos réglages par défaut.`,
  },
}[lang];

// Release assets, as the GitHub Actions workflows name them (Standalone and
// Plugin, attached to a `v*` release). Each row is filled at runtime from
// the latest release; without JS, or before the first release, every row
// falls back to the Releases page and the build instructions.
const platforms = [
  {
    os: 'windows',
    name: 'Windows',
    blurb: fr ? 'x86-64 · WASAPI et ASIO' : 'x86-64 · WASAPI and ASIO',
    files: [
      { match: '^unsampled-piano-setup-windows', label: fr ? 'Installateur' : 'Installer', note: fr ? 'application, VST3 et CLAP — chacun au choix' : 'application, VST3 and CLAP — each optional', primary: true },
      { match: '^unsampled-piano-standalone-windows', label: fr ? 'Portable' : 'Portable', note: fr ? 'unsampled-piano.exe et les presets, rien à installer' : 'unsampled-piano.exe and presets, nothing to install' },
      { match: '^unsampled-piano-windows', label: fr ? 'Plugins seuls' : 'Plugins only', note: fr ? 'bundles VST3 et CLAP' : 'VST3 and CLAP bundles' },
    ],
  },
  {
    os: 'macos',
    name: 'macOS',
    blurb: fr ? 'universel · Intel et Apple silicon · CoreAudio' : 'universal · Intel and Apple silicon · CoreAudio',
    files: [
      { match: '^unsampled-piano-standalone-macos', label: 'Application', note: fr ? 'Unsampled Piano.app — non notarisée : clic droit → Ouvrir la première fois' : 'Unsampled Piano.app — not notarised: right-click → Open the first time', primary: true },
      { match: '^unsampled-piano-macos', label: 'Plugins', note: fr ? 'bundles VST3 et CLAP' : 'VST3 and CLAP bundles' },
    ],
  },
  {
    os: 'linux',
    name: 'Linux',
    blurb: 'x86-64 · PipeWire / JACK',
    files: [{ match: '^unsampled-piano-linux', label: 'Plugins', note: fr ? 'bundles VST3 et CLAP, pour ~/.vst3 et ~/.clap' : 'VST3 and CLAP bundles, for ~/.vst3 and ~/.clap', primary: true }],
  },
];
---

<BaseLayout title={T.title} description={T.description}>
  <section class="dl-hero">
    <GlowBackground />
    <div class="container">
      <p class="eyebrow">{T.title}</p>
      <h1 class="glow-text">{T.head}</h1>
      <p class="dl-lede" set:html={T.lede(`${SITE.github}/releases`)} />
      <p class="dl-release" data-release data-lang={lang}>{T.looking}</p>
    </div>
  </section>

  <section class="section dl-section">
    <div class="container dl-grid">
      {
        platforms.map((p) => (
          <article class="card dl-card" data-os={p.os}>
            <header>
              <h2>{p.name}</h2>
              <p class="dl-blurb">{p.blurb}</p>
            </header>
            <ul class="dl-files">
              {p.files.map((f) => (
                <li data-match={f.match} class:list={{ primary: f.primary }}>
                  <a class:list={['dl-link', f.primary ? 'btn btn-primary' : 'btn btn-secondary']} href={`${SITE.github}/releases/latest`} rel="noopener">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M12 3v12m0 0 4-4m-4 4-4-4M5 21h14"></path>
                    </svg>
                    <span>{f.label}</span>
                    <span class="dl-size" data-size></span>
                  </a>
                  <span class="dl-note">{f.note}</span>
                </li>
              ))}
            </ul>
            {p.os === 'linux' && (
              <p class="dl-source" set:html={T.linuxSource(L('/docs/getting-started/#linux'))} />
            )}
          </article>
        ))
      }
    </div>

    <div class="container dl-build">
      <h2>{T.buildTitle}</h2>
      <p>{T.buildText}</p>
      <pre><code>git clone {SITE.github}
cd unsampled-piano
cargo run --release -p piano-play -- --ui           {T.buildPlayer}
cargo xtask bundle piano-plugin --release           {T.buildPlugin}</code></pre>
      <p class="dl-more" set:html={T.more(L('/docs/getting-started/'))} />
    </div>
  </section>
</BaseLayout>

<script>
  import { fetchGitHubJson } from '../scripts/github';

  function detectOS(): string | null {
    const nav = navigator as any;
    const plat = (nav.userAgentData?.platform || nav.platform || '').toLowerCase();
    const ua = navigator.userAgent.toLowerCase();
    if (plat.includes('win') || ua.includes('windows')) return 'windows';
    if (plat.includes('mac') || ua.includes('mac os')) return 'macos';
    if (plat.includes('linux') || ua.includes('linux')) return ua.includes('android') ? null : 'linux';
    return null;
  }

  const fmtSize = (b: number) => (b >= 1048576 ? `${(b / 1048576).toFixed(1)} MB` : `${Math.round(b / 1024)} KB`);

  async function initDownloads() {
    const status = document.querySelector<HTMLElement>('[data-release]');
    if (!status || status.dataset.done) return;
    status.dataset.done = '1';

    const fr = status.dataset.lang === 'fr';
    const gs = fr ? '/fr/docs/getting-started/' : '/docs/getting-started/';
    const os = detectOS();
    if (os) {
      const card = document.querySelector<HTMLElement>(`.dl-card[data-os="${os}"]`);
      card?.classList.add('detected');
      card?.parentElement?.prepend(card);
      const label = document.querySelector<HTMLElement>('[data-detected-os]');
      const name = { windows: 'Windows', macos: 'macOS', linux: 'Linux' }[os];
      if (label) label.textContent = fr ? `${name} en premier, puisque c’est votre système` : `${name} first, as that's what you're on`;
    }

    try {
      const releases: any[] = await fetchGitHubJson(`/repos/mgth/unsampled-piano/releases?per_page=10`);
      const rel = releases.find((r) => !r.draft && !r.prerelease && r.assets?.length);
      if (!rel) {
        status.innerHTML = fr
          ? `Aucune version n’est encore publiée : les compilations sortent pour l’instant des workflows GitHub Actions. <a href="${gs}">Compilez depuis les sources</a>, ou suivez le dépôt pour la première version.`
          : `No release is published yet: the builds come from the GitHub Actions workflows for now. <a href="${gs}">Build from source</a>, or watch the repository for the first release.`;
        status.classList.add('none');
        // releases/latest would 404 on GitHub: send the buttons to the build instructions.
        document.querySelectorAll<HTMLAnchorElement>('.dl-link').forEach((a) => {
          a.href = gs;
          a.classList.add('pending');
          a.title = fr ? 'Pas encore de version — voir comment compiler' : 'No release yet — see how to build it';
        });
        return;
      }
      const date = new Date(rel.published_at).toLocaleDateString(fr ? 'fr-FR' : undefined, { year: 'numeric', month: 'long', day: 'numeric' });
      status.innerHTML = `${fr ? 'Dernière version :' : 'Latest release:'} <a href="${rel.html_url}" rel="noopener">${rel.tag_name}</a> · ${date}`;
      document.querySelectorAll<HTMLElement>('.dl-files li[data-match]').forEach((li) => {
        const re = new RegExp(li.dataset.match!, 'i');
        const asset = rel.assets.find((a: any) => re.test(a.name));
        const link = li.querySelector<HTMLAnchorElement>('a')!;
        if (!asset) {
          link.href = rel.html_url;
          return;
        }
        link.href = asset.browser_download_url;
        link.title = asset.name;
        li.querySelector<HTMLElement>('[data-size]')!.textContent = fmtSize(asset.size);
      });
    } catch {
      status.innerHTML = fr
        ? `Impossible de joindre GitHub pour l’instant — toutes les versions sont sur la <a href="https://github.com/mgth/unsampled-piano/releases" rel="noopener">page Releases</a>.`
        : `Couldn't reach GitHub just now — every build is on the <a href="https://github.com/mgth/unsampled-piano/releases" rel="noopener">Releases page</a>.`;
    }
  }
  document.addEventListener('astro:page-load', initDownloads);
  initDownloads();
</script>

<style>
  .dl-hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--up-border);
    background: radial-gradient(120% 100% at 30% 0%, var(--up-bg-radial-from), var(--up-bg-radial-to) 70%);
    padding-block: clamp(48px, 8vw, 88px);
  }
  .dl-hero .container {
    position: relative;
    z-index: 1;
  }
  .dl-hero h1 {
    margin-top: 10px;
    font-size: clamp(2.4rem, 7vw, 3.8rem);
  }
  .dl-lede {
    margin-top: 18px;
    max-width: 62ch;
    font-size: 1.08rem;
  }
  .dl-release {
    margin-top: 18px;
    font-family: var(--up-font-mono);
    font-size: 0.82rem;
    color: var(--up-text-muted);
  }
  .dl-release.none {
    max-width: 70ch;
    padding: 10px 14px;
    border-left: 2px solid var(--up-accent);
    background: rgba(242, 181, 68, 0.06);
    border-radius: 0 var(--up-radius-sm) var(--up-radius-sm) 0;
  }
  .dl-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  .dl-card {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .dl-card.detected {
    border-color: var(--up-accent);
    box-shadow: 0 0 0 1px var(--up-accent), 0 18px 50px -24px rgba(242, 181, 68, 0.6);
  }
  .dl-card h2 {
    font-size: 1.5rem;
  }
  .dl-blurb {
    margin-top: 4px;
    font-family: var(--up-font-mono);
    font-size: 0.78rem;
    color: var(--up-text-muted);
  }
  .dl-files {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }
  .dl-files li {
    display: grid;
    gap: 6px;
  }
  .dl-link {
    justify-content: flex-start;
  }
  .dl-link.pending {
    opacity: 0.55;
    filter: saturate(0.4);
  }
  .dl-size {
    margin-left: auto;
    font-family: var(--up-font-mono);
    font-size: 0.75rem;
    opacity: 0.75;
  }
  .dl-note,
  .dl-source {
    font-size: 0.86rem;
    color: var(--up-text-muted);
  }
  .dl-build {
    margin-top: clamp(48px, 7vw, 80px);
    max-width: 52rem;
  }
  .dl-build h2 {
    font-size: clamp(1.5rem, 3.4vw, 2rem);
  }
  .dl-build p {
    margin-top: 10px;
    color: var(--up-text-muted);
  }
  .dl-build pre {
    margin-top: 16px;
    padding: 16px 18px;
    border-radius: var(--up-radius);
    border: 1px solid var(--up-border);
    background: #0d121d;
    overflow-x: auto;
    font-size: 0.86rem;
    line-height: 1.7;
  }
  .dl-more {
    margin-top: 16px;
  }
  @media (max-width: 980px) {
    .dl-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
