---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Figure from '../components/diagrams/Figure.astro';
import DocsLayout from '../layouts/DocsLayout.astro';
import ParamList from '../components/params/ParamList.astro';
import { pageEntries, sectionTitle, pageLabel } from '../lib/params';
import type { DocEntry } from '../lib/docs';
import { langOf, ui } from '../i18n';

// A docs page, English or French (src/pages/docs and src/pages/fr/docs).
interface Props {
  entry: DocEntry;
}
const { entry } = Astro.props;
const lang = langOf(Astro.url);
const t = ui(lang);
const { Content, headings } = await render(entry);
// A parameter page lists its parameters after the prose; their groups join
// the "On this page" contents.
const page = entry.data.page;
// The interface's own page, captured by the UI demo (PIANO_UI_SHOT), as
// src/assets/ui/<slug>.png.
const shots = import.meta.glob<{ default: ImageMetadata }>('../assets/ui/*.png', { eager: true });
const shot = page ? shots[`../assets/ui/${entry.id.split('/').pop()}.png`]?.default : undefined;
const groupHeadings = page
  ? [
      { depth: 2, slug: 'parameters', text: t.parameters },
      ...pageEntries(page).map(({ group }) => ({ depth: 3, slug: `group-${group}`, text: sectionTitle(page, group, lang) })),
    ]
  : [];
---

<DocsLayout title={entry.data.title} description={entry.data.description} headings={[...headings, ...groupHeadings]}>
  <Content />
  {
    page && (
      <Fragment>
        {shot && (
          <Figure label={t.inTheApp} caption={t.inTheAppCaption(pageLabel(page, lang))}>
            <Image src={shot} alt={t.inTheAppAlt(pageLabel(page, lang))} widths={[700, 1100, 1375]} sizes="(max-width: 860px) 92vw, 50rem" class="app-shot" />
          </Figure>
        )}
        <h2 id="parameters">{t.parameters}</h2>
        <ParamList page={page} />
      </Fragment>
    )
  }
</DocsLayout>

<style>
  :global(.prose img.app-shot) {
    display: block;
    width: 100%;
    height: auto;
    margin: 0 !important;
    max-width: 100% !important;
    border-radius: 6px;
  }
</style>
