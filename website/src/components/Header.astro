---
import Logo from './Logo.astro';
import { SITE } from '../site';
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="header-brand" aria-label={`${SITE.name} home`}>
      <Logo />
    </a>

    <button class="nav-toggle" aria-expanded="false" aria-controls="primary-nav" aria-label="Toggle navigation">
      <span></span><span></span><span></span>
    </button>

    <nav id="primary-nav" class="primary-nav" aria-label="Primary">
      <a href="/download/">Download</a>
      <a href="/docs/">Docs</a>
      <a href="/docs/parameters/">Parameters</a>
      <a href={SITE.github} rel="noopener">GitHub</a>
      <a href={SITE.kofi} class="nav-donate" rel="noopener">Ko-fi</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--up-header-h);
    backdrop-filter: blur(12px);
    background: rgba(11, 15, 24, 0.72);
    border-bottom: 1px solid var(--up-border);
  }
  .header-inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .header-brand {
    color: inherit;
  }
  .primary-nav {
    display: flex;
    align-items: center;
    gap: clamp(14px, 2.4vw, 30px);
  }
  .primary-nav a {
    font-family: var(--up-font-display);
    font-weight: 500;
    font-size: 0.97rem;
    color: var(--up-text);
  }
  .primary-nav a:hover {
    color: var(--up-accent-light);
  }
  .nav-donate {
    padding: 0.45em 0.95em;
    border: 1px solid var(--up-border-strong);
    border-radius: var(--up-radius-sm);
    color: var(--up-accent) !important;
  }
  .nav-donate:hover {
    background: rgba(242, 181, 68, 0.1);
  }

  /* Mobile toggle (hidden on desktop). */
  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 42px;
    height: 42px;
    padding: 0;
    background: transparent;
    border: 1px solid var(--up-border);
    border-radius: var(--up-radius-sm);
    cursor: pointer;
  }
  .nav-toggle span {
    display: block;
    width: 18px;
    height: 2px;
    margin-inline: auto;
    background: var(--up-text-bright);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  @media (max-width: 720px) {
    .nav-toggle {
      display: flex;
    }
    .primary-nav {
      position: absolute;
      top: var(--up-header-h);
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 8px 0 14px;
      background: rgba(11, 15, 24, 0.97);
      border-bottom: 1px solid var(--up-border);
      transform: translateY(-130%);
      transition: transform 0.22s ease;
    }
    .primary-nav.open {
      transform: translateY(0);
    }
    .primary-nav a {
      padding: 12px clamp(20px, 5vw, 40px);
    }
    .nav-donate {
      margin: 8px clamp(20px, 5vw, 40px) 0;
      text-align: center;
    }
  }
</style>

<script>
  // Re-runs after every client-router navigation (the header DOM is replaced);
  // the data-bound guard keeps the initial load from binding twice.
  function initNav() {
    const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
    const nav = document.getElementById('primary-nav');
    if (!toggle || toggle.dataset.bound) return;
    toggle.dataset.bound = '1';
    toggle.addEventListener('click', () => {
      const open = nav?.classList.toggle('open') ?? false;
      toggle.setAttribute('aria-expanded', String(open));
    });
    // Close the menu after following an in-page link.
    nav?.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => {
        nav.classList.remove('open');
        toggle.setAttribute('aria-expanded', 'false');
      }),
    );
  }
  document.addEventListener('astro:page-load', initNav);
  initNav();
</script>
