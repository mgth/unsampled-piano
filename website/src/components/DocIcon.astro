---
// Line icons for the docs cards. Keyed by the `icon` frontmatter value; each is a
// 24x24 stroke glyph that inherits `currentColor` from the card's icon badge.
interface Props {
  name?: string;
}
const { name = 'doc' } = Astro.props;

const GLYPHS: Record<string, string> = {
  // Guides
  rocket:
    '<path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="M12 15l-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/>',
  sliders:
    '<line x1="21" x2="14" y1="4" y2="4"/><line x1="10" x2="3" y1="4" y2="4"/><line x1="21" x2="12" y1="12" y2="12"/><line x1="8" x2="3" y1="12" y2="12"/><line x1="21" x2="16" y1="20" y2="20"/><line x1="12" x2="3" y1="20" y2="20"/><line x1="14" x2="14" y1="2" y2="6"/><line x1="8" x2="8" y1="10" y2="14"/><line x1="16" x2="16" y1="18" y2="22"/>',
  layers:
    '<path d="m12 2 10 5-10 5L2 7z"/><path d="m2 12 10 5 10-5"/><path d="m2 17 10 5 10-5"/>',
  midi:
    '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="7" r="1"/><circle cx="7.5" cy="10" r="1"/><circle cx="16.5" cy="10" r="1"/><circle cx="8.5" cy="15" r="1"/><circle cx="15.5" cy="15" r="1"/><path d="M10 20.5h4"/>',
  terminal: '<polyline points="4 17 10 11 4 5"/><line x1="12" x2="20" y1="19" y2="19"/>',
  atom: '<path d="M2 12h3l2-6 3 12 3-9 2 6 2-3h5"/>',
  // Parameter pages
  player:
    '<rect x="2" y="5" width="20" height="9" rx="1.5"/><path d="M6 5v5M10 5v5M14 5v5M18 5v5"/><path d="M8 18h8M12 14v4"/><path d="M6 22h4M14 22h4"/>',
  mic: '<rect x="9" y="2" width="6" height="12" rx="3"/><path d="M5 10a7 7 0 0 0 14 0"/><path d="M12 17v5M8 22h8"/>',
  hammer:
    '<rect x="13" y="3" width="8" height="7" rx="3.5"/><path d="M15 10 4 21"/><path d="M2 3h6"/><path d="M5 3v3"/>',
  fork: '<path d="M9 2v7a3 3 0 0 0 6 0V2"/><path d="M12 12v10"/><path d="M18 5c1.5 1.5 1.5 4 0 5.5M20.5 3c2.5 2.7 2.5 6.8 0 9.5"/>',
  string:
    '<circle cx="3" cy="12" r="1.6"/><circle cx="21" cy="12" r="1.6"/><path d="M4.6 12c3-6 5-6 7.4 0s4.4 6 7.4 0"/>',
  damper:
    '<path d="M2 16h20"/><rect x="8" y="9" width="8" height="5" rx="1"/><path d="M12 9V3"/><path d="M9 6l3-3 3 3"/>',
  noise:
    '<path d="M12 22v-6"/><rect x="7" y="12" width="10" height="4" rx="1"/><path d="M12 8V2M6.5 9.5 3 6M17.5 9.5 21 6"/>',
  board:
    '<path d="M3 20c0-9 3-16 9-17 5 0 9 3 9 8v9z"/><path d="M7 18c2-6 5-10 10-11"/><path d="M14 18c1-2 2-3 4-4"/>',
  frame:
    '<path d="M3 21V9a6 6 0 0 1 6-6h6a6 6 0 0 1 6 6v12z"/><circle cx="9" cy="10" r="2"/><circle cx="15" cy="10" r="2"/><circle cx="12" cy="16" r="2"/>',
  room: '<path d="M3 8 12 3l9 5v13H3z"/><path d="M7 21v-6h4"/><path d="M15 12c1.5 1 1.5 3 0 4M18 10.5c2.5 2 2.5 5 0 7"/>',
  doc: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/>',
};
const glyph = GLYPHS[name] ?? GLYPHS.doc;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class="doc-icon"
  set:html={glyph}
/>

<style>
  .doc-icon {
    width: 22px;
    height: 22px;
    display: block;
  }
</style>
