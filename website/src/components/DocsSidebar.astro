---
import { docsOf } from '../lib/docs';
import { localePath, langOf, ui } from '../i18n';

const lang = langOf(Astro.url);
const t = ui(lang);
const entries = await docsOf(lang);
const current = Astro.url.pathname.replace(/\/$/, '');
const base = localePath(lang, '/docs');
const groups = [
  { title: t.guides, entries: entries.filter((e) => e.data.section === 'Guides') },
  { title: t.parameters, href: `${base}/parameters`, entries: entries.filter((e) => e.data.section === 'Parameters') },
];
---

<nav class="docs-sidebar" aria-label={t.documentation}>
  {
    groups.map((g) => (
      <Fragment>
        <p class="docs-sidebar-heading eyebrow">
          {g.href ? <a href={`${g.href}/`} class:list={{ active: current === g.href }}>{g.title}</a> : g.title}
        </p>
        <ul>
          {g.entries.map((entry) => {
            const href = `${base}/${entry.id}`;
            const active = current === href;
            return (
              <li>
                <a href={`${href}/`} class={active ? 'active' : ''} aria-current={active ? 'page' : undefined}>
                  {entry.data.title}
                </a>
              </li>
            );
          })}
        </ul>
      </Fragment>
    ))
  }
</nav>

<style>
  .docs-sidebar-heading {
    margin-bottom: 10px;
  }
  .docs-sidebar ul + .docs-sidebar-heading {
    margin-top: 26px;
  }
  .docs-sidebar .docs-sidebar-heading a {
    display: inline;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font-size: inherit;
  }
  .docs-sidebar .docs-sidebar-heading a:hover {
    color: var(--up-accent-light);
    background: none;
  }
  .docs-sidebar ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
  }
  .docs-sidebar a {
    display: block;
    padding: 8px 12px;
    border-radius: var(--up-radius-sm);
    color: var(--up-text-muted);
    font-size: 0.95rem;
    border-left: 2px solid transparent;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .docs-sidebar a:hover {
    color: var(--up-text-bright);
    background: rgba(242, 181, 68, 0.06);
  }
  .docs-sidebar a.active {
    color: var(--up-accent-light);
    background: rgba(242, 181, 68, 0.1);
    border-left-color: var(--up-accent);
  }
</style>
