---
// The two soft pedals the model knows: a grand's una corda shifts the whole
// action sideways so each hammer misses one string (seen from above), an
// upright's half blow brings the hammers closer to the strings (seen from
// the side). Both loop: pedal up, pedal down.
import Figure from './Figure.astro';
import { def, fmt } from '../../lib/params';
import type { Lang } from '../../i18n';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;

const soft = def('una_corda_softening');
const DUR = '5s';
const KT = '0;0.3;0.42;0.75;0.87;1';

const T = {
  en: {
    label: 'Soft pedal (CC 67)',
    caption: `Left, a grand (<code>una_corda_shift</code> = 1): the action slides so the hammer strikes two strings of three; the first gets 1 − s of the force, and the felt that now meets the strings is unworn, softer by <code>una_corda_softening</code> = ${fmt(soft)} at full pedal. Right, an upright (<code>una_corda_shift</code> = 0): nothing slides, the hammers rest closer to the strings and strike slower by <code>half_blow</code>.`,
    aria: 'Una corda shift on a grand seen from above, and half blow on an upright seen from the side',
    grand: 'grand · from above',
    hammer: 'hammer (worn grooves)',
    string1: 'string 1 · gets (1 − s) of the force',
    shift: 'shift',
    fresh: 'fresh felt, softer',
    freshX: 58,
    upright: 'upright · from the side',
    damper: 'damper',
    rail: 'hammer rail',
    travel: 'travel',
  },
  fr: {
    label: 'Pédale douce (CC 67)',
    caption: `À gauche, un piano à queue (<code>una_corda_shift</code> = 1) : la mécanique se décale et le marteau frappe deux cordes sur trois ; la première reçoit 1 − s de la force, et le feutre qui rencontre désormais les cordes n’est pas usé, plus souple de <code>una_corda_softening</code> = ${fmt(soft)} pédale à fond. À droite, un piano droit (<code>una_corda_shift</code> = 0) : rien ne se décale, les marteaux reposent plus près des cordes et frappent moins vite, selon <code>half_blow</code>.`,
    aria: 'Décalage una corda d’un piano à queue vu de dessus, et demi-course d’un piano droit vu de côté',
    grand: 'à queue · vu de dessus',
    hammer: 'marteau (sillons usés)',
    string1: 'corde 1 · reçoit (1 − s) de la force',
    shift: 'décalage',
    fresh: 'feutre neuf, plus souple',
    freshX: 76,
    upright: 'droit · vu de côté',
    damper: 'étouffoir',
    rail: 'barre de repos',
    travel: 'course',
  },
}[lang];
---

<Figure
  label={T.label}
  caption={T.caption}
>
  <svg viewBox="0 0 480 170" role="img" aria-label={T.aria}>
    <text class="dg-title" x="14" y="16">{T.grand}</text>
    {[62, 82, 102].map((y, i) => (
      <line class="dg-string" x1="20" x2="226" y1={y} y2={y} style={i === 0 ? 'opacity: 1' : undefined}>
        {i === 0 && <animate attributeName="opacity" values="1;1;0.3;0.3;1;1" keyTimes={KT} dur={DUR} repeatCount="indefinite"></animate>}
      </line>
    ))}
    <g>
      <animateTransform attributeName="transform" type="translate" values="0,0;0,0;0,20;0,20;0,0;0,0" keyTimes={KT} dur={DUR} repeatCount="indefinite" calcMode="spline" keySplines="0 0 1 1;.5 0 .5 1;0 0 1 1;.5 0 .5 1;0 0 1 1"></animateTransform>
      <rect x="96" y="50" width="34" height="64" rx="8" class="dg-felt" opacity="0.92"></rect>
      {[62, 82, 102].map((y) => <line x1="99" x2="127" y1={y} y2={y} stroke="#8d8676" stroke-width="2.4" stroke-linecap="round"></line>)}
      <text class="dg-text" x="136" y="46">{T.hammer}</text>
    </g>
    <text class="dg-text" x="20" y="138">{T.string1}</text>
    <text class="dg-hl" x="20" y="152">
      {T.shift}
      <animate attributeName="opacity" values="0;0;1;1;0;0" keyTimes={KT} dur={DUR} repeatCount="indefinite"></animate>
    </text>
    <text class="dg-text" x={T.freshX} y="152">
      {T.fresh}
      <animate attributeName="opacity" values="0;0;1;1;0;0" keyTimes={KT} dur={DUR} repeatCount="indefinite"></animate>
    </text>

    <line class="dg-faint" x1="246" x2="246" y1="14" y2="160"></line>

    <text class="dg-title" x="262" y="16">{T.upright}</text>
    <line class="dg-string" x1="440" x2="440" y1="28" y2="160"></line>
    <rect x="446" y="64" width="10" height="20" rx="2" class="dg-felt" opacity="0.8"></rect>
    <text class="dg-text" x="452" y="58" text-anchor="middle">{T.damper}</text>
    <g>
      <animateTransform attributeName="transform" type="translate" values="0,0;0,0;34,0;34,0;0,0;0,0" keyTimes={KT} dur={DUR} repeatCount="indefinite" calcMode="spline" keySplines="0 0 1 1;.5 0 .5 1;0 0 1 1;.5 0 .5 1;0 0 1 1"></animateTransform>
      <rect x="276" y="134" width="40" height="7" rx="2" fill="#6b7280"></rect>
      <text class="dg-text" x="276" y="155">{T.rail}</text>
      <line x1="300" y1="134" x2="350" y2="104" stroke="var(--up-copper)" stroke-width="3" stroke-linecap="round"></line>
      <rect x="346" y="92" width="22" height="26" rx="9" class="dg-felt"></rect>
    </g>
    <line x1="372" y1="105" x2="434" y2="105" stroke="var(--up-accent)" stroke-dasharray="3 3" marker-end="url(#sp-arrow)">
      <animate attributeName="x1" values="372;372;406;406;372;372" keyTimes={KT} dur={DUR} repeatCount="indefinite" calcMode="spline" keySplines="0 0 1 1;.5 0 .5 1;0 0 1 1;.5 0 .5 1;0 0 1 1"></animate>
    </line>
    <text class="dg-hl" x="403" y="98" text-anchor="middle">{T.travel}</text>
    <defs>
      <marker id="sp-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
        <path d="M0 0 10 5 0 10z" fill="var(--up-accent)"></path>
      </marker>
    </defs>
  </svg>
</Figure>
