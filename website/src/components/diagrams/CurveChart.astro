---
// A per-key (or per-velocity) law of the default instrument, as the
// interface plots it: the curve draws itself when it scrolls into view, and
// hovering reads the value at any key.
import Figure from './Figure.astro';
import { curve, fmt, noteName } from '../../lib/params';

interface Props {
  /** Title of a curve exported by the interface (params.json pages[].curves). */
  title?: string;
  /** Or explicit points, with their unit and scale. */
  points?: [number, number][];
  unit?: string;
  log?: boolean;
  /** x axis: MIDI notes, MIDI velocities, or a plain 0–1 travel. */
  x?: 'key' | 'velocity' | 'travel' | 'plain';
  /** Unit of a plain x axis. */
  xUnit?: string;
  label?: string;
  caption?: string;
  /** y range override [min, max]. */
  y?: [number, number];
}
const props = Astro.props;
const c = props.title ? curve(props.title) : null;
const points = props.points ?? c!.points;
const unit = props.unit ?? c?.unit ?? '';
const log = props.log ?? c?.log ?? false;
const xKind = props.x ?? (points[0][0] === 1 && points.at(-1)![0] === 127 ? 'velocity' : 'key');

const W = 480;
const H = 240;
const L = 52;
const R = 14;
const T = 24;
const B = 34;

const xs = points.map((p) => p[0]);
const ys = points.map((p) => p[1]);
const x0 = Math.min(...xs);
const x1 = Math.max(...xs);
let [y0, y1] = props.y ?? [Math.min(...ys), Math.max(...ys)];
let yTicks: number[];
if (log) {
  y0 = 10 ** Math.floor(Math.log10(y0));
  y1 = 10 ** Math.ceil(Math.log10(y1));
  yTicks = [];
  for (let e = Math.log10(y0); e <= Math.log10(y1) + 1e-9; e++) yTicks.push(10 ** e);
} else {
  const span = y1 - y0 || Math.abs(y1) || 1;
  const step = [1, 2, 2.5, 5, 10].map((m) => m * 10 ** Math.floor(Math.log10(span / 4))).find((s) => span / s <= 5)!;
  if (!props.y) {
    y0 = Math.floor(y0 / step) * step;
    y1 = Math.ceil(y1 / step) * step;
    if (y0 === y1) y1 = y0 + step;
  }
  yTicks = [];
  for (let v = y0; v <= y1 + step * 1e-6; v += step) yTicks.push(+v.toFixed(10));
}
const sx = (x: number) => L + ((x - x0) / (x1 - x0)) * (W - L - R);
const sy = (y: number) =>
  T + (1 - (log ? Math.log(y / y0) / Math.log(y1 / y0) : (y - y0) / (y1 - y0))) * (H - T - B);

const d = points.map(([x, y], i) => `${i ? 'L' : 'M'}${sx(x).toFixed(1)} ${sy(y).toFixed(1)}`).join(' ');
const area = `${d} L${sx(x1).toFixed(1)} ${H - B} L${sx(x0).toFixed(1)} ${H - B} Z`;

const xTicks =
  xKind === 'key'
    ? [21, 36, 48, 60, 72, 84, 96, 108]
    : xKind === 'velocity'
      ? [1, 32, 64, 96, 127]
      : [0, 0.25, 0.5, 0.75, 1].map((f) => x0 + f * (x1 - x0));
const xUnit = props.xUnit ?? '';
const xText = (x: number) =>
  xKind === 'key' ? noteName(x) : xKind === 'travel' ? `${Math.round(x * 100)} %` : xKind === 'plain' ? `${fmt(x)}${xUnit ? ` ${xUnit}` : ''}` : String(x);
const readout = points.map(([x, y]) => [sx(x), sy(y), `${xKind === 'velocity' ? `vel ${x}` : xText(x)} · ${fmt(y)}${unit ? ` ${unit}` : ''}`]);
const label = props.label ?? c?.title;
---

<Figure label={label} caption={props.caption}>
  <svg class="curve-chart" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`${label}: curve over ${xKind === 'key' ? 'the keyboard' : xKind}`} data-readout={JSON.stringify(readout)}>
    <defs>
      <linearGradient id={`cc-fill-${label?.replace(/\W/g, '')}`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#f2b544" stop-opacity="0.22"></stop>
        <stop offset="1" stop-color="#f2b544" stop-opacity="0"></stop>
      </linearGradient>
    </defs>
    {yTicks.map((v) => (
      <g>
        <line class="grid" x1={L} x2={W - R} y1={sy(v)} y2={sy(v)}></line>
        <text class="tick" x={L - 7} y={sy(v) + 3.5} text-anchor="end">{fmt(v)}</text>
      </g>
    ))}
    {xTicks.map((v) => (
      <g>
        <line class="grid grid-x" x1={sx(v)} x2={sx(v)} y1={T} y2={H - B}></line>
        <text class="tick" x={sx(v)} y={H - B + 15} text-anchor="middle">{xText(v)}</text>
      </g>
    ))}
    {unit && <text class="unit" x={L - 7} y={T - 3} text-anchor="end">{unit}</text>}
    <path class="area" d={area} fill={`url(#cc-fill-${label?.replace(/\W/g, '')})`}></path>
    <path class="line" d={d} pathLength="1"></path>
    <g class="cursor" visibility="hidden">
      <line class="cursor-line" y1={T} y2={H - B}></line>
      <circle r="4.5"></circle>
      <text class="cursor-text" y={T + 12}></text>
    </g>
    <rect class="hit" x={L} y={T} width={W - L - R} height={H - T - B} fill="transparent"></rect>
  </svg>
</Figure>

<style>
  .grid {
    stroke: rgba(242, 181, 68, 0.08);
  }
  .tick,
  .unit {
    fill: var(--up-text-muted);
    font-family: var(--up-font-mono);
    font-size: 10px;
  }
  .unit {
    fill: var(--up-accent);
  }
  .line {
    fill: none;
    stroke: var(--up-accent-light);
    stroke-width: 2.2;
    stroke-linejoin: round;
    filter: drop-shadow(0 0 5px rgba(242, 181, 68, 0.55));
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) :global(.fig:not(.is-revealed)) .line {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
    }
    :global(html.js) :global(.fig:not(.is-revealed)) .area {
      opacity: 0;
    }
    .line {
      stroke-dasharray: 1;
      transition: stroke-dashoffset 1.4s cubic-bezier(0.4, 0, 0.2, 1) 0.2s;
    }
    .area {
      transition: opacity 1s ease 0.9s;
    }
  }
  .cursor-line {
    stroke: var(--up-accent);
    stroke-dasharray: 3 3;
  }
  .cursor circle {
    fill: var(--up-bg);
    stroke: var(--up-accent-light);
    stroke-width: 2;
  }
  .cursor-text {
    fill: var(--up-text-bright);
    font-family: var(--up-font-mono);
    font-size: 11px;
    paint-order: stroke;
    stroke: var(--up-bg);
    stroke-width: 4px;
  }
  .hit {
    cursor: crosshair;
  }
</style>

<script>
  // Hover readout: the nearest point under the pointer, its value beside it.
  function initCurves() {
    document.querySelectorAll<SVGSVGElement>('svg.curve-chart:not([data-bound])').forEach((svg) => {
      svg.dataset.bound = '1';
      const pts: [number, number, string][] = JSON.parse(svg.dataset.readout ?? '[]');
      const cursor = svg.querySelector<SVGGElement>('.cursor')!;
      const line = cursor.querySelector('line')!;
      const dot = cursor.querySelector('circle')!;
      const text = cursor.querySelector('text')!;
      const hit = svg.querySelector('.hit')!;
      const vbW = svg.viewBox.baseVal.width;
      hit.addEventListener('pointermove', (ev) => {
        const e = ev as PointerEvent;
        const r = svg.getBoundingClientRect();
        const x = ((e.clientX - r.left) / r.width) * vbW;
        let best = pts[0];
        for (const p of pts) if (Math.abs(p[0] - x) < Math.abs(best[0] - x)) best = p;
        line.setAttribute('x1', String(best[0]));
        line.setAttribute('x2', String(best[0]));
        dot.setAttribute('cx', String(best[0]));
        dot.setAttribute('cy', String(best[1]));
        const right = best[0] > vbW * 0.62;
        text.setAttribute('x', String(best[0] + (right ? -9 : 9)));
        text.setAttribute('text-anchor', right ? 'end' : 'start');
        text.textContent = best[2];
        cursor.setAttribute('visibility', 'visible');
      });
      hit.addEventListener('pointerleave', () => cursor.setAttribute('visibility', 'hidden'));
    });
  }
  document.addEventListener('astro:page-load', initCurves);
  initCurves();
</script>
