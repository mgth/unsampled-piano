---
// The cast-iron frame and the rim of the default instrument, from above and
// to scale (left), and in section along the strings (right, heights
// exaggerated). Strings pull on the frame at the agraffes; the board's edges
// shake the rim. Both radiate on their own, one way: the model does not feed
// their motion back into the strings.
import Figure from './Figure.astro';
import { BOARD, bridgePoint, planView } from '../../lib/geometry';
import { def, fmt } from '../../lib/params';

const { a, b } = BOARD;
const F = {
  a: def('frame.a'),
  b: def('frame.b'),
  x0: def('frame.offset_x'),
  agraffe: def('frame.agraffe_x'),
  h: def('frame.height'),
  solidity: def('frame.solidity'),
};
const R = { t: def('rim.thickness'), h: def('rim.height'), top: def('rim.top') };
const v = planView(100, 160, 244);
const agraffeX = F.x0 + F.agraffe;
const strings = Array.from({ length: 15 }, (_, i) => 21 + Math.round((i * 87) / 14)).map((n) => {
  const [x, y] = bridgePoint(n);
  return { n, x, y };
});

// Section along the strings: x horizontal, z up (×3).
const SX = (x: number) => 250 + (x - F.x0) * 112;
const SZ = (z: number) => 120 - z * 330;
---

<Figure
  label="Frame and rim · plan and section"
  caption={`Left, from above: the frame (grey, ${fmt(F.a)} × ${fmt(F.b)} m, ${Math.round(F.solidity * 100)} % metal) starts ${fmt(-F.x0)} m in front of the board, over the tuning pins; the strings bear on it at the agraffe line and on the board at the bridges. The rim (copper outline) runs round the board's edge. Right, in section with heights exaggerated: the frame ${fmt(F.h)} m above the board, the rim wall ${fmt(R.h)} m high rising ${fmt(R.top)} m above it.`}
>
  <svg viewBox="0 0 480 268" role="img" aria-label="Plan and section of the frame, rim, soundboard and strings">
    <rect x={v.X(b)} y={v.Y(a)} width={b * v.s} height={a * v.s} class="dg-board"></rect>
    <rect class="rim" x={v.X(b) - R.t * v.s} y={v.Y(a) - R.t * v.s} width={(b + 2 * R.t) * v.s} height={(a + 2 * R.t) * v.s} rx="4"></rect>
    <g opacity="0.85">
      <rect x={v.X(F.b)} y={v.Y(F.x0 + F.a)} width={F.b * v.s} height={F.a * v.s} rx="10" fill="rgba(159,176,200,0.22)" stroke="#9fb0c8"></rect>
      {[[0.35, 0.3], [0.7, 0.62], [0.45, 0.75], [0.9, 0.35], [1.2, 0.8], [0.95, 0.95]].map(([x, y]) => (
        <ellipse cx={v.X(y)} cy={v.Y(x)} rx="9" ry="13" fill="#0b0f18" stroke="#9fb0c8" stroke-width="0.8"></ellipse>
      ))}
    </g>
    {strings.map((s, i) => (
      <g>
        <line x1={v.X(s.y)} x2={v.X(s.y)} y1={v.Y(agraffeX)} y2={v.Y(s.x)} stroke="rgba(255,210,122,0.75)" stroke-width="1"></line>
        <circle r="2" fill="var(--up-accent-light)">
          <animateMotion path={`M${v.X(s.y)} ${v.Y(s.x)} L${v.X(s.y)} ${v.Y(agraffeX)}`} dur="1.6s" begin={`${(i % 5) * 0.3}s`} repeatCount="indefinite"></animateMotion>
        </circle>
      </g>
    ))}
    <line x1={v.X(b)} x2={v.X(0)} y1={v.Y(agraffeX)} y2={v.Y(agraffeX)} stroke="var(--up-ivory)" stroke-width="2.5"></line>
    <text class="dg-label" x={v.X(0) + 8} y={v.Y(agraffeX) + 4}>agraffes</text>
    <text class="dg-text" x={v.X(0) + 8} y={v.Y(a / 2)}>board</text>
    <text class="dg-text" x={v.X(0) + 8} y={v.Y(F.x0 + F.a) + 10} style="fill:#9fb0c8">frame</text>
    <text class="dg-text" x={v.X(0) + 8} y={v.Y(a) - 2} style="fill:var(--up-copper)">rim</text>

    <text class="dg-title" x="250" y="24">section along the strings</text>
    <line x1={SX(0)} x2={SX(a)} y1={SZ(0)} y2={SZ(0)} stroke="var(--up-copper)" stroke-width="3"></line>
    <text class="dg-text" x={SX(a / 2)} y={SZ(0) + 14} text-anchor="middle">board</text>
    <rect x={SX(F.x0)} y={SZ(F.h) - 4} width={F.a * 112} height="8" rx="2" fill="#9fb0c8" opacity="0.8"></rect>
    <text class="dg-text" x={SX(F.x0) + 4} y={SZ(F.h) - 9} style="fill:#9fb0c8">frame</text>
    <line x1={SX(agraffeX)} x2={SX(bridgePoint(60)[0])} y1={SZ(F.h) - 6} y2={SZ(0.012)} stroke="var(--up-accent-light)" stroke-width="1.5"></line>
    <path d={`M${SX(bridgePoint(60)[0]) - 5} ${SZ(0)} l5 -6 l5 6 z`} fill="var(--up-copper)"></path>
    <text class="dg-hl" x={SX(bridgePoint(60)[0]) + 8} y={SZ(0.02)}>string C4</text>
    {[0, a].map((x) => (
      <rect class="rim-sec" x={SX(x) - (x ? 0 : R.t * 112)} y={SZ(R.top)} width={R.t * 112} height={R.h * 330}></rect>
    ))}
    <text class="dg-text" x={SX(a) + 12} y={SZ(R.top - R.h / 2)} style="fill:var(--up-copper)">rim</text>
    <path class="dg-faint" d={`M${SX(a) + 8} ${SZ(R.top)} h4 M${SX(a) + 8} ${SZ(R.top - R.h)} h4`}></path>
  </svg>
</Figure>

<style>
  .rim {
    fill: none;
    stroke: var(--up-copper);
    stroke-width: 7.5;
    stroke-opacity: 0.55;
    stroke-dasharray: 10 6;
  }
  .rim-sec {
    fill: rgba(217, 130, 59, 0.45);
    stroke: var(--up-copper);
  }
  @media (prefers-reduced-motion: no-preference) {
    .rim {
      animation: rim-flow 2.4s linear infinite;
    }
  }
  @keyframes rim-flow {
    to {
      stroke-dashoffset: -32;
    }
  }
</style>
