---
// The room presets (presets/listening/Room), from above and to scale, with
// the default instrument and its microphones. The direct wavefront and the
// wall images' wavefronts expand together: inside the room, the images'
// circles are the reflections (image-source method). Below, the echogram at
// the left microphone: direct sound, then each image's arrival up to the
// second order, then the reverberant tail at the Sabine decay rate.
import Figure from './Figure.astro';
import { BOARD } from '../../lib/geometry';
import { def, fmt } from '../../lib/params';
import { preset, presetTitle } from '../../lib/presets';

const { a, b } = BOARD;
const mic0 = [0, 1, 2].map((c) => def(`soundboard.mics[0][${c}]`));
const mic1 = [0, 1, 2].map((c) => def(`soundboard.mics[1][${c}]`));
const C = 343;

const rooms = ['concert_hall', 'small_hall', 'studio'].map((name) => {
  const r = preset('listening', name).values.room;
  const [L, Wd, Ht] = r.size as number[];
  const P = r.piano as number[];
  const src = [P[0] + a / 2, P[1] + b / 2, P[2]];
  const mics = [mic0, mic1].map((m) => [P[0] + m[0], P[1] + m[1], P[2] + m[2]]);
  const alpha = (r.absorption_low + r.absorption_high) / 2;
  const V = L * Wd * Ht;
  const S = 2 * (L * Wd + L * Ht + Wd * Ht);
  const t60 = (al: number) => (0.161 * V) / (S * al);

  // Plan scale: fit the room in 440 × 200.
  const s = Math.min(440 / L, 200 / Wd);
  const ox = 20 + (440 - L * s) / 2;
  const oy = 34 + (200 - Wd * s) / 2;
  const X = (x: number) => ox + x * s;
  const Y = (y: number) => oy + y * s;
  // First and second order images in the plan (x and y walls).
  // Image n of coordinate v between walls 0 and len: even n shift, odd n mirror.
  const mirror = (v: number, n: number, len: number) => (n % 2 === 0 ? v + n * len : (n + 1) * len - v);
  const imgs2d: [number, number, number][] = [];
  for (let i = -2; i <= 2; i++)
    for (let j = -2; j <= 2; j++) if (Math.abs(i) + Math.abs(j) <= 2) imgs2d.push([mirror(src[0], i, L), mirror(src[1], j, Wd), Math.abs(i) + Math.abs(j)]);

  // Echogram at the left mic: images up to order 2 in 3D.
  const arrivals: { t: number; db: number; order: number }[] = [];
  for (let i = -2; i <= 2; i++)
    for (let j = -2; j <= 2; j++)
      for (let k = -2; k <= 2; k++) {
        const order = Math.abs(i) + Math.abs(j) + Math.abs(k);
        if (order > 2) continue;
        const p = [mirror(src[0], i, L), mirror(src[1], j, Wd), mirror(src[2], k, Ht)];
        const d = Math.hypot(p[0] - mics[0][0], p[1] - mics[0][1], p[2] - mics[0][2]);
        arrivals.push({ t: d / C, db: 20 * Math.log10(1 / d) + 10 * order * Math.log10(1 - alpha), order });
      }
  const top = Math.max(...arrivals.map((x) => x.db));
  const maxR = Math.hypot(Math.max(src[0], L - src[0]) * 3, Math.max(src[1], Wd - src[1]) * 3);
  return { name, title: presetTitle(name), L, Wd, Ht, src, mics, X, Y, s, imgs2d, arrivals: arrivals.map((x) => ({ ...x, db: x.db - top })), t60Low: t60(r.absorption_low), t60High: t60(r.absorption_high), maxR, alpha };
});

// Echogram frame.
const E0 = 46, E1 = 466, EY0 = 262, EY1 = 352;
const DUR = 3.2;
// Deterministic jitter for the tail.
let seed = 7;
const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
---

<Figure
  label="The room · from above, and at the microphone"
  caption="Top: the room from above, to scale, the piano (copper) and its two microphones (blue). The wavefront from the piano and those of its images in the walls expand together; inside the room, the images' wavefronts are the reflections — that is the image-source method the model uses for the early echoes, each order with its own wall filtering. Bottom: what the left microphone receives — the direct sound, each reflection up to the second order at its delay, then the reverberant tail of a 16-line feedback delay network, decaying at the Sabine rate."
>
  <div data-rooms>
    <div class="room-tabs" role="tablist" aria-label="Room">
      {rooms.map((r, i) => (
        <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-room={i}>{r.title}</button>
      ))}
    </div>
    <svg viewBox="0 0 480 372" role="img" aria-label="Plan of the room with reflections, and the echogram at the microphone">
      {rooms.map((r, i) => {
        const tMax = Math.max(0.08, Math.min(0.5, r.L / C * 1.6));
        const ex = (t: number) => E0 + (t / tMax) * (E1 - E0);
        const ey = (db: number) => EY0 + (-db / 50) * (EY1 - EY0);
        const tail = Array.from({ length: 160 }, (_, k) => {
          const t = tMax * 0.25 + (k / 159) * tMax * 0.75;
          const db = -12 - (60 * (t - tMax * 0.25)) / r.t60Low - rnd() * 7;
          return `${k ? 'L' : 'M'}${ex(t).toFixed(1)} ${ey(Math.max(-50, db)).toFixed(1)}`;
        }).join(' ');
        return (
          <g class="room" data-room={i} visibility={i === 0 ? 'visible' : 'hidden'}>
            <defs>
              <clipPath id={`room-clip-${i}`}>
                <rect x={r.X(0)} y={r.Y(0)} width={r.L * r.s} height={r.Wd * r.s}></rect>
              </clipPath>
            </defs>
            <rect x={r.X(0)} y={r.Y(0)} width={r.L * r.s} height={r.Wd * r.s} fill="rgba(79,201,192,0.04)" stroke="#4fc9c0" stroke-width="1.5"></rect>
            <g clip-path={`url(#room-clip-${i})`}>
              {r.imgs2d.map(([x, y, order]) => (
                <circle cx={r.X(x)} cy={r.Y(y)} r="1" fill="none" stroke={order ? '#4fc9c0' : 'var(--up-accent-light)'} stroke-width={order ? 1.2 : 2} opacity="0">
                  <animate attributeName="r" values={`1;${r.maxR * r.s}`} dur={`${DUR}s`} repeatCount="indefinite"></animate>
                  <animate attributeName="opacity" values={`${order ? 0.75 / order : 1};0`} dur={`${DUR}s`} repeatCount="indefinite"></animate>
                </circle>
              ))}
            </g>
            <rect x={r.X(r.src[0] - a / 2)} y={r.Y(r.src[1] - b / 2)} width={a * r.s} height={b * r.s} fill="var(--up-copper)" rx="2"></rect>
            {r.mics.map((m) => <circle cx={r.X(m[0])} cy={r.Y(m[1])} r="3.2" fill="#6cb8ff"></circle>)}
            <text class="dg-label" x={r.X(0)} y={r.Y(0) - 8}>{fmt(r.L)} × {fmt(r.Wd)} × {fmt(r.Ht)} m</text>
            <text class="dg-text dg-end" x={r.X(r.L)} y={r.Y(0) - 8}>T60 {fmt(+r.t60Low.toFixed(2))} s low · {fmt(+r.t60High.toFixed(2))} s high</text>

            <text class="dg-title" x={E0} y={EY0 - 12}>echogram · left microphone · dB</text>
            <path class="dg-faint" d={`M${E0} ${EY0 - 4}V${EY1}H${E1}`}></path>
            {[0, -20, -40].map((d) => <text class="dg-text dg-end" x={E0 - 4} y={ey(d) + 3}>{d}</text>)}
            {[0, 0.25, 0.5, 0.75, 1].map((f) => <text class="dg-text dg-mid" x={ex(f * tMax)} y={EY1 + 13}>{Math.round(f * tMax * 1000)} ms</text>)}
            <path d={tail} fill="none" stroke="rgba(79,201,192,0.45)" stroke-width="0.9"></path>
            {r.arrivals.filter((x) => x.t <= tMax).map((x) => (
              <line x1={ex(x.t)} x2={ex(x.t)} y1={EY1} y2={ey(Math.max(-50, x.db))} stroke={x.order ? '#4fc9c0' : 'var(--up-accent-light)'} stroke-width={x.order ? 1.3 : 2.4} opacity={x.order === 2 ? 0.7 : 1}></line>
            ))}
            <text class="dg-hl" x={ex(r.arrivals.find((x) => x.order === 0)!.t) + 5} y={ey(-2)}>direct</text>
          </g>
        );
      })}
    </svg>
  </div>
</Figure>

<style>
  .room-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 6px;
  }
  .room-tabs button {
    appearance: none;
    padding: 3px 12px;
    border-radius: 999px;
    border: 1px solid var(--up-border);
    background: transparent;
    color: var(--up-text-muted);
    font-family: var(--up-font-mono);
    font-size: 0.76rem;
    cursor: pointer;
  }
  .room-tabs button[aria-selected='true'] {
    color: #061413;
    background: #4fc9c0;
    border-color: #4fc9c0;
  }
</style>

<script>
  function initRooms() {
    document.querySelectorAll<HTMLElement>('[data-rooms]:not([data-bound])').forEach((box) => {
      box.dataset.bound = '1';
      const tabs = box.querySelectorAll<HTMLButtonElement>('button[data-room]');
      const groups = box.querySelectorAll<SVGGElement>('g.room');
      tabs.forEach((t) =>
        t.addEventListener('click', () => {
          tabs.forEach((u) => u.setAttribute('aria-selected', String(u === t)));
          groups.forEach((g) => g.setAttribute('visibility', g.dataset.room === t.dataset.room ? 'visible' : 'hidden'));
        }),
      );
    });
  }
  document.addEventListener('astro:page-load', initRooms);
  initRooms();
</script>
