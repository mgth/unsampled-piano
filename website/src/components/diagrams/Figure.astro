---
// Frame of a diagram in the docs: the drawing, a mono label, a caption.
// `wide` lets a figure use the full reading width on its own row; figures
// placed in a <FigureRow> share it.
interface Props {
  label?: string;
  caption?: string;
}
const { label, caption } = Astro.props;
---

<figure class="fig" data-reveal>
  {label && <p class="fig-label">{label}</p>}
  <div class="fig-body">
    <slot />
  </div>
  {caption && <figcaption set:html={caption} />}
</figure>

<style>
  .fig {
    margin: 1.8em 0;
    padding: 16px 18px 14px;
    border: 1px solid var(--up-border);
    border-radius: var(--up-radius);
    background:
      radial-gradient(120% 90% at 50% 0%, rgba(29, 36, 51, 0.7), transparent 70%),
      rgba(11, 15, 24, 0.6);
  }
  .fig-label {
    margin: 0 0 8px !important;
    font-family: var(--up-font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--up-accent);
  }
  .fig-body :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  figcaption {
    margin-top: 10px;
    font-size: 0.86rem;
    line-height: 1.55;
    color: var(--up-text-muted);
  }
  figcaption :global(code) {
    font-size: 0.85em;
  }
</style>
