---
import Logo from './Logo.astro';
import { SITE } from '../site';
// Build-time year: refreshes on every deploy, never goes stale in between.
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <Logo />
      <p class="footer-tagline">{SITE.tagline}</p>
    </div>

    <nav class="footer-links" aria-label="Footer">
      <a href="/download/">Download</a>
      <a href="/docs/">Documentation</a>
      <a href="/docs/parameters/">Parameter reference</a>
      <a href={SITE.github} rel="noopener">GitHub</a>
      <a href={SITE.kofi} rel="noopener">Ko-fi</a>
    </nav>
  </div>

  <div class="container footer-meta">
    <span>&copy; {year} Mathieu GRENET &middot; Licensed under {SITE.license} &middot; No samples were harmed</span>
    <span>Built with <a href="https://astro.build" rel="noopener">Astro</a></span>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    padding-block: 48px 28px;
    border-top: 1px solid var(--up-border);
    background: linear-gradient(180deg, transparent, rgba(29, 36, 51, 0.45));
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 28px 48px;
    justify-content: space-between;
    align-items: flex-start;
  }
  .footer-tagline {
    margin-top: 12px;
    max-width: 32ch;
    color: var(--up-text-muted);
    font-size: 0.95rem;
  }
  .footer-links {
    display: grid;
    gap: 10px;
  }
  .footer-links a {
    color: var(--up-text);
    font-size: 0.95rem;
  }
  .footer-links a:hover {
    color: var(--up-accent-light);
  }
  .footer-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    justify-content: space-between;
    margin-top: 36px;
    padding-top: 20px;
    border-top: 1px solid var(--up-border);
    color: var(--up-text-muted);
    font-size: 0.85rem;
  }
</style>
