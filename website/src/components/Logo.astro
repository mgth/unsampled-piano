---
// Inline brand mark + wordmark: the application icon (assets/icon.svg), a
// string held at the agraffe and the bridge above a keyboard. Inlined so the
// string can ring: a standing wave is its mode shape times cos(ωt), so the
// animation is just scaleY about the string's axis, swinging through ±1 with
// a decaying amplitude, struck again every few seconds. Static under
// prefers-reduced-motion.
interface Props {
  withWordmark?: boolean;
  size?: number;
}
const { withWordmark = true, size = 34 } = Astro.props;
---

<span class="logo">
  <svg class="logo-mark" width={size} height={size} viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <rect width="100" height="100" rx="22" fill="#1d2433"></rect>
    <path d="M18 50 Q50 14 82 50" fill="none" stroke="#f2b544" stroke-width="2" opacity=".5"></path>
    <path d="M18 50 Q50 86 82 50" fill="none" stroke="#f2b544" stroke-width="2" opacity=".5"></path>
    <path class="logo-string" d="M18 50 Q34 30 50 50 T82 50" fill="none" stroke="#ffd27a" stroke-width="3.5" stroke-linecap="round"></path>
    <circle cx="18" cy="50" r="5" fill="#e8e2d4"></circle>
    <circle cx="82" cy="50" r="5" fill="#c8722c"></circle>
    <rect x="18" y="74" width="64" height="10" rx="2" fill="#e8e2d4"></rect>
    <rect x="27" y="74" width="5" height="6" fill="#1d2433"></rect>
    <rect x="39" y="74" width="5" height="6" fill="#1d2433"></rect>
    <rect x="56" y="74" width="5" height="6" fill="#1d2433"></rect>
    <rect x="66" y="74" width="5" height="6" fill="#1d2433"></rect>
  </svg>
  {withWordmark && <span class="logo-word">Unsampled <span>Piano</span></span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
  }
  .logo-mark {
    border-radius: 8px;
    filter: drop-shadow(0 0 10px rgba(242, 181, 68, 0.3));
  }
  .logo-word {
    font-family: var(--up-font-display);
    font-weight: 600;
    font-size: 1.18rem;
    letter-spacing: -0.01em;
    color: var(--up-text-bright);
  }
  .logo-word span {
    color: var(--up-accent);
  }

  .logo-string {
    transform-box: view-box;
    transform-origin: 50px 50px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .logo-string {
      animation: logo-ring 5.5s linear infinite;
    }
  }
  /* Half periods of a decaying swing, then rest until the next strike. */
  @keyframes logo-ring {
    0% { transform: scaleY(1); animation-timing-function: ease-in-out; }
    4% { transform: scaleY(-0.82); animation-timing-function: ease-in-out; }
    8% { transform: scaleY(0.66); animation-timing-function: ease-in-out; }
    12% { transform: scaleY(-0.53); animation-timing-function: ease-in-out; }
    16% { transform: scaleY(0.42); animation-timing-function: ease-in-out; }
    20% { transform: scaleY(-0.33); animation-timing-function: ease-in-out; }
    24% { transform: scaleY(0.26); animation-timing-function: ease-in-out; }
    28% { transform: scaleY(-0.2); animation-timing-function: ease-in-out; }
    32% { transform: scaleY(0.15); animation-timing-function: ease-in-out; }
    36% { transform: scaleY(-0.1); animation-timing-function: ease-in-out; }
    40% { transform: scaleY(0.06); animation-timing-function: ease-in-out; }
    46%, 92% { transform: scaleY(0.02); }
    100% { transform: scaleY(1); }
  }
</style>
