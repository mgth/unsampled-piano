---
import { SITE } from '../site';
// Support buttons. Ko-fi first — it is the link the application's own status
// bar carries — as a first-class button in the site's style; GitHub Sponsors
// and Liberapay beside it. Plain links: no third-party script or iframe.
---

<span class="sponsor-widget">
  <a class="sponsor-btn kofi" href={SITE.kofi} rel="noopener" aria-label="Support mgth on Ko-fi">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="cup">
      <path d="M17 8h1a4 4 0 1 1 0 8h-1"></path>
      <path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"></path>
      <path class="steam" d="M6 2v2M10 2v2M14 2v2"></path>
    </svg>
    <span>Buy me a coffee</span>
  </a>
  <a class="sponsor-btn gh" href={SITE.donate} rel="noopener" aria-label="Sponsor mgth on GitHub Sponsors">
    <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" class="heart">
      <path
        d="m8 14.25.345.666a.75.75 0 0 1-.69 0l-.008-.004-.018-.01a7.152 7.152 0 0 1-.31-.17 22.055 22.055 0 0 1-3.434-2.414C2.045 10.731 0 8.35 0 5.5 0 2.836 2.086 1 4.25 1 5.797 1 7.153 1.802 8 3.020 8.847 1.802 10.203 1 11.75 1 13.914 1 16 2.836 16 5.5c0 2.85-2.045 5.231-3.885 6.818a22.066 22.066 0 0 1-3.744 2.584l-.018.01-.006.003h-.002Z"
      ></path>
    </svg>
    <span>Sponsor</span>
  </a>
  <a class="img-btn" href={SITE.liberapay} rel="noopener" aria-label="Donate to mgth using Liberapay">
    <img src="https://liberapay.com/assets/widgets/donate.svg" alt="Donate using Liberapay" height="32" loading="lazy" />
  </a>
</span>

<style>
  .sponsor-widget {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .sponsor-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 36px;
    padding: 0 16px;
    border-radius: 7px;
    font-family: var(--up-font-display);
    font-weight: 600;
    font-size: 0.92rem;
    transition:
      transform 0.15s ease,
      background 0.2s ease,
      box-shadow 0.2s ease,
      color 0.2s ease;
  }
  .sponsor-btn svg {
    width: 17px;
    height: 17px;
    transition: transform 0.2s ease;
  }
  .sponsor-btn:hover {
    transform: translateY(-1px);
  }
  .kofi {
    color: #1a1206;
    background: linear-gradient(135deg, var(--up-accent-light), var(--up-accent-deep));
    box-shadow: 0 0 22px rgba(242, 181, 68, 0.32);
  }
  .kofi:hover {
    color: #1a1206;
    box-shadow: 0 0 32px rgba(242, 181, 68, 0.5);
  }
  @media (prefers-reduced-motion: no-preference) {
    .kofi:hover .steam {
      animation: steam 0.9s ease-in-out infinite alternate;
    }
  }
  @keyframes steam {
    to {
      transform: translateY(-1.5px);
      opacity: 0.4;
    }
  }
  .gh {
    color: #ffd7ec;
    background: rgba(219, 97, 162, 0.14);
    border: 1px solid rgba(219, 97, 162, 0.5);
  }
  .gh .heart {
    color: #db61a2;
  }
  .gh:hover {
    background: rgba(219, 97, 162, 0.22);
    box-shadow: 0 0 26px rgba(219, 97, 162, 0.4);
    color: #fff;
  }
  .gh:hover .heart {
    transform: scale(1.12);
  }
  .img-btn {
    display: inline-flex;
    border-radius: 6px;
    transition: transform 0.15s ease;
  }
  .img-btn:hover {
    transform: translateY(-1px);
  }
  .img-btn img {
    display: block;
    height: 32px;
    border-radius: 6px;
  }
</style>
