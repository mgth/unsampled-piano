{
  "name": "unsampled-piano-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Public website and documentation of Unsampled Piano, the physically modelled piano.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "deploy": "bash scripts/deploy.sh",
    "params": "cargo run -q -p piano-ui --example param_reference > src/data/params.json",
    "demos": "bash scripts/render-demos.sh"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/mdx": "^8.1.0",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "astro": "^7.0.4",
    "smol-toml": "^1.9.1",
    "typescript": "^5.7.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
