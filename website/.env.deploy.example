# o2switch FTP deployment credentials.
# Copy this file to `.env.deploy` and fill in real values. `.env.deploy` is
# gitignored — never commit real credentials.
#
# Values are read literally (the file is NOT sourced as a shell script), so a
# password may contain spaces or special characters ($ ! & # etc.) with no
# quoting. Just avoid a leading/trailing space. Surrounding "quotes" or 'quotes',
# if you add them, are stripped.

# FTP host (from your o2switch cPanel — e.g. ftp.mgth.fr or the server hostname).
FTP_HOST=ftp.example.o2switch.net
FTP_USER=your_ftp_user
FTP_PASS=your_ftp_password

# Remote directory that maps to https://unsampled.mgth.fr — the subdomain's docroot.
# Typically something like /unsampled.mgth.fr or /public_html/unsampled.
FTP_REMOTE_DIR=/unsampled.mgth.fr

# Use FTPS (recommended). Set FTP_SSL=false only if the host has no TLS on FTP.
FTP_SSL=true
# o2switch's FTP cert often doesn't match the raw hostname; leave verification off
# unless you know it matches.
FTP_SSL_VERIFY=false

# Delete remote files that no longer exist locally. Keep false unless
# FTP_REMOTE_DIR is a dedicated docroot containing ONLY this site.
FTP_DELETE=false
